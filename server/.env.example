# Puerto donde escucha la API HTTP (no confundir con el puerto de PostgreSQL)
API_PORT=4000

# Usá una clave larga alfanumérica; no la compartas ni la subas a Git.
POSTGRES_PASSWORD=cambiar-por-una-clave-larga

# PostgreSQL: en este proyecto Postgres escucha en el puerto 3433 (ver docker-compose.yml)
# Nota: esta variable solo aplica si corrés la API con "node src/index.js"
# directamente (fuera de docker compose). Si usás docker compose, el
# DATABASE_URL ya está fijado en docker-compose.yml (apunta al servicio
# "postgres" en la red interna, puerto 5432).
DATABASE_URL=postgres://control_stok:control_stok_password@localhost:3433/control_stok_celu

# Secreto para firmar los JWT de sesion. Cambialo en produccion.
# Si usás docker compose, este mismo archivo .env (en la carpeta server/) se
# usa automáticamente para reemplazar ${JWT_SECRET} en docker-compose.yml.
JWT_SECRET=cambiar-este-secreto-en-produccion
JWT_EXPIRES_IN=30d

# Usuario admin creado automaticamente la primera vez que se corre la migracion
# (solo si no existe ningun usuario todavia).
SEED_ADMIN_USERNAME=jefe
SEED_ADMIN_PASSWORD=cambiar123
